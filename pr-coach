#!/usr/bin/env python3
"""Run the checkout without installing it or changing the caller's directory."""
import sys
from pathlib import Path

from coach.__main__ import main

if __name__ == "__main__":
    root = Path(__file__).resolve().parent
    example = root / "results" / "pr11-checked.json"
    if len(sys.argv) == 1 and example.is_file():
        sys.argv.extend(["--open", str(example), "--state-dir", str(root / ".coach")])
    raise SystemExit(main())
